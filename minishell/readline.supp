{
    <readline>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:readline
}
{
    <add_history>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:add_history
}
{
    <rl_history_reachable>
    Memcheck:Leak
    match-leak-kinds: reachable
    ...
    fun:xmalloc
    fun:add_history
}
{
    <tgetstr>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:tgetstr
}
{
    <tgetent>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:tgetent
}
{
    <rl_add_undo>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:rl_add_undo
}
{
    <rl_bracketed_paste>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:rl_bracketed_paste_begin
}
{
    <rl_insert_text>
    Memcheck:Leak
    match-leak-kinds: all
    ...
    fun:rl_insert_text
}
